{
  "$schema": "https://opencode.ai/config.json",

  // Conservative defaults for a first OpenCode production project.
  // Routine inspection is allowed; destructive or remote Git actions are blocked.
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },

    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },

    { "action": "shell", "resource": "npm run lint *", "effect": "allow" },
    { "action": "shell", "resource": "npm run typecheck *", "effect": "allow" },
    { "action": "shell", "resource": "npm run test *", "effect": "allow" },
    { "action": "shell", "resource": "npm run build *", "effect": "allow" },

    {
      "action": "shell",
      "resource": "npx prisma validate *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "npx prisma generate *",
      "effect": "allow",
    },

    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git reset *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git rebase *", "effect": "deny" },

    {
      "action": "shell",
      "resource": "npx prisma migrate reset *",
      "effect": "deny",
    },
    { "action": "shell", "resource": "*force-reset*", "effect": "deny" },
    {
      "action": "shell",
      "resource": "docker system prune *",
      "effect": "deny",
    },

    { "action": "shell", "resource": "Remove-Item *", "effect": "ask" },
    { "action": "shell", "resource": "del *", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
  ],
}
