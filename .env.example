# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://teammate:teammate@localhost:5432/teammate
# Integration tests only: must target a separate local database ending in _test.
TEST_DATABASE_URL=postgresql://teammate:teammate@localhost:5432/teammate_test

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Email (Phase 1 production auth email delivery)
# Resend API key. Production only; development uses the in-memory transport.
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx
# Bare mailbox address only. The "TeamMate" display name is fixed in code, so
# do not use display-name syntax such as "TeamMate <no-reply@example.com>".
# The sending domain must be verified in Resend.
AUTH_EMAIL_FROM_ADDRESS=no-reply@your-domain.example

# Redis / rate limiting / cache (Phase 6+)
REDIS_URL=redis://localhost:6379

# Object storage (avatar uploads)
# S3-compatible object storage. The client is created lazily, so these may stay
# empty for local development, a build, and unit tests; avatar operations fail
# closed in production when they are missing.
# Use "true" for path-style addressing, which most self-hosted providers need.
# Any value other than "false" enables it, and leaving it unset defaults to on.
# An http:// endpoint is accepted only when NODE_ENV is exactly "development" or
# "test", for local MinIO. Leave this empty to use real AWS, which needs no endpoint.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Deliberately unused. Avatars are served only through the authorized same-origin
# /avatars/<token> route, never from a public bucket URL.
S3_PUBLIC_BASE_URL=

# AI (Phase 6)
OPENAI_API_KEY=

# Observability (Phase 8)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
